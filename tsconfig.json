{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "chrome",
      "node",
      "vite/client",
      "vitest/globals"
    ]
  },
  "include": [
    "src",
    "tests",
    "demo",
    "vite.config.ts",
    "vite.demo.config.ts",
    "manifest.config.ts"
  ]
}
