{
  "name": "clean-bili-spam",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "用户可控、可解释的 B 站低质量账号识别浏览器插件。",
  "license": "MIT",
  "author": "suyc123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suyc321/clean-bili-spam.git"
  },
  "bugs": {
    "url": "https://github.com/suyc321/clean-bili-spam/issues"
  },
  "homepage": "https://github.com/suyc321/clean-bili-spam#readme",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:build",
    "e2e": "node scripts/e2e-fixture.mjs",
    "verify:e2e": "npm run build && node scripts/e2e-fixture.mjs",
    "demo:build": "vite build --config vite.demo.config.ts",
    "demo": "npm run demo:build && node scripts/serve-demo.mjs 8642"
  },
  "dependencies": {
    "idb": "8.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@types/chrome": "0.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
